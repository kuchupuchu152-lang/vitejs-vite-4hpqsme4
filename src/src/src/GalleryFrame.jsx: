import { useMemo } from 'react'
import * as THREE from 'three'

const FZ = [-7, -13, -19, -25, -31, -37]
const PHOTOS = ['/us-1.jpg', '/king-2.jpg', '/us-2.jpg', '/king-3.jpg', '/us-3.jpg', '/king-5.jpg', '/us-4.jpg', '/king-6.jpg', '/us-6.jpg', '/king-7.jpg', '/us-7.jpg', '/king-8.jpg']
const ASPECT = 1.24 / 1.64

function useCover(url) {
  return useMemo(() => {
    const t = new THREE.TextureLoader().load(url, (tx) => {
      const ia = tx.image.width / tx.image.height
      if (ia > ASPECT) {
        tx.repeat.set(ASPECT / ia, 1)
        tx.offset.set((1 - ASPECT / ia) / 2, 0)
      } else {
        tx.repeat.set(1, ia / ASPECT)
        tx.offset.set(0, (1 - ia / ASPECT) / 2)
      }
      tx.needsUpdate = true
    })
    t.colorSpace = THREE.SRGBColorSpace
    return t
  }, [url])
}

export default function GalleryFrame({ side, z }) {
  const idx = FZ.indexOf(z) * 2 + (side < 0 ? 0 : 1)
  const tex = useCover(PHOTOS[idx] || PHOTOS[0])
  return (
    <group position={[side * 2.82, 2.4, z]} rotation-y={(-side * Math.PI) / 2}>
      <mesh>
        <boxGeometry args={[1.5, 1.9, 0.08]} />
        <meshStandardMaterial color="#d4a93a" metalness={0.4} roughness={0.35} emissive="#6b4e0a" />
      </mesh>
      <mesh position={[0, 0, 0.045]}>
        <planeGeometry args={[1.24, 1.64]} />
        <meshBasicMaterial map={tex} />
      </mesh>
    </group>
  )
}
